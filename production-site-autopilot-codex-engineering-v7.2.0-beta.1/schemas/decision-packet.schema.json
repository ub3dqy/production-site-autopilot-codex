{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consolidated owner decision packet",
  "type": "object",
  "required": ["checkpoint", "items", "independent_work_continues"],
  "properties": {
    "checkpoint": {"type": "string", "minLength": 1},
    "independent_work_continues": {"type": "boolean"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "options", "blocks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "options": {"type": "array", "items": {"type": "string"}, "minItems": 2},
          "default": {"type": ["string", "null"]},
          "blocks": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
